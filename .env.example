# Copy this to .env and fill in values
# NEVER commit .env to git

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eakp
DB_USER=eakp
DB_PASS=eakp_local_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=eakp
RABBITMQ_PASS=eakp_local_pass

# MinIO / S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=eakp-documents

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=dGhpcy1pcy1hLXZlcnktbG9uZy1zZWNyZXQta2V5LWZvci1kZXZlbG9wbWVudC1vbmx5LW1pbmltdW0tMjU2LWJpdHM=

# LLM — local (Ollama): leave blank
# LLM — cloud (Groq): get free key at console.groq.com
GROQ_API_KEY=

# Embeddings — cloud (HuggingFace): get free key at huggingface.co
HF_API_KEY=

# Spring profile: local | prod
SPRING_PROFILES_ACTIVE=local
